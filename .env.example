# Порт сервера (Render подставляет автоматически)
PORT=3001

# Опциональный общий пароль для входа в любую комнату (оставьте пустым, чтобы отключить)
ROOM_PASSWORD=

# Настройки TURN-сервера (опционально, но крайне рекомендуется для друзей за строгим NAT)
# Можно указать несколько URL через запятую, например: turn:a.relay.metered.ca:80,turns:a.relay.metered.ca:443?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# URL клиента для CORS в dev-режиме (в продакшене клиент раздаётся тем же сервером)
CLIENT_ORIGIN=http://localhost:5173
